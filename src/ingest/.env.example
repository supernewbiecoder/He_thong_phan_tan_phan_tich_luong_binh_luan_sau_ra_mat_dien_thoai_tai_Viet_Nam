# Mục đích: Mẫu file bí mật của crawler. Chép thành src/ingest/.env rồi điền giá trị; .env không bao giờ được commit; cập nhật lần cuối: 2026-11-11.
YOUTUBE_API_KEY=
# Để trống KAFKA_BOOTSTRAP thì crawler chỉ ghi file JSONL (chế độ không Kafka)
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=raw_comments
# Muối khi băm channel ID tác giả (đặt 1 lần, cả nhóm dùng chung, KHÔNG commit lên git)
AUTHOR_SALT=doi_chuoi_nay
# Chia việc nhiều máy: p1 (máy tổng hợp) hoặc p2...; kênh có `owner: p2` trong config/pipeline.yaml chỉ máy p2 cào
CRAWLER_WORKER=p1
