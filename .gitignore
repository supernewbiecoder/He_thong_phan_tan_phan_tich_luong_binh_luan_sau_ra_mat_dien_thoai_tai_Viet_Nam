# Mục đích: File không đưa lên git: dữ liệu, file model, môi trường Python, file bí mật, file tự sinh; cập nhật lần cuối: 2026-11-19.

# Dữ liệu (GitHub giới hạn 100 MB/file; dữ liệu chia sẻ ngoài git, xem docs/0-chung/cai-dat.md)
data/
*.jsonl
*.csv
*.parquet
*.zip
*.tar.gz

# File model đã huấn luyện: sinh lại bằng code, không đưa lên git
*.pkl
*.joblib

# Python & Jupyter
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Virtual Environments
.venv/
venv/
env/
ENV/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local runtime logs and credentials
*.log
.env
